{
  "folders": [
    { "name": "firmware", "path": "firmware" },
    { "name": "app", "path": "app" },
    { "name": "repo", "path": "." }
  ],
  // No machine-specific paths here: clangd settings live in firmware/.vscode/settings.json,
  // and rust-analyzer finds app/Cargo.toml by itself.
  "settings": {
    "files.exclude": { "firmware": true, "app": true }
  },
  "extensions": {
    "recommendations": [
      "pioarduino.pioarduino-ide",
      "llvm-vs-code-extensions.vscode-clangd",
      "rust-lang.rust-analyzer"
    ]
  }
}

	(text "J5: BME280 (pin 1 GND, 2 SDA, 3 VDD, 4 SCL) or DS18B20 (pins 1-3: GND, DQ, VDD) on a cable at the frame"
		(exclude_from_sim no)
		(at 381 50.8 0)
		(effects

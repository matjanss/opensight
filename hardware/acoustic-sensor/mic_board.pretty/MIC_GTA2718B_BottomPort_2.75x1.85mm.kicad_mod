(footprint "MIC_GTA2718B_BottomPort_2.75x1.85mm" (version 20221018) (generator pcbnew)
  (layer "F.Cu")
  (descr "Gettop GTA2718B-3 / -3HA analog bottom-port MEMS mic, 2.75x1.85x1.0 mm. Origin = acoustic port centre. Land pattern from the GTA2718B-3 datasheet (LCSC C50275772), Fig. 11 and Recommended PCB Design Pattern: GND ring OD 1.45 / ID 0.95 around the port, NPTH 0.5 (0.5-0.7 recommended); pads 0.545 x 0.65 mm, 0.95 mm apart, inner edge 1.205 mm from the port centre. Seen from the top (the datasheet draws the bottom), pin 1 (VDD) is at +y with the pads at +x; the silkscreen dot and the lid marking are at that corner. Checked 2026-11-23.")
  (tags "MEMS microphone bottom port")
  (attr smd)
  (fp_text reference "REF**" (at 0.5 -1.75) (layer "F.SilkS") (effects (font (size 0.7 0.7) (thickness 0.12))))
  (fp_text value "GTA2718B-3" (at 0.5 1.75) (layer "F.Fab") (effects (font (size 0.5 0.5) (thickness 0.08))))
  (fp_rect (start -0.875 -0.925) (end 1.875 0.925) (stroke (width 0.1) (type default)) (fill none) (layer "F.Fab"))
  (fp_circle (center 0 0) (end 0.175 0) (stroke (width 0.05) (type default)) (fill none) (layer "F.Fab"))
  (fp_line (start -0.98 -1.03) (end 1.98 -1.03) (stroke (width 0.12) (type default)) (layer "F.SilkS"))
  (fp_line (start -0.98 1.03) (end 1.98 1.03) (stroke (width 0.12) (type default)) (layer "F.SilkS"))
  (fp_line (start -0.98 -1.03) (end -0.98 1.03) (stroke (width 0.12) (type default)) (layer "F.SilkS"))
  (fp_circle (center 2.25 0.475) (end 2.35 0.475) (stroke (width 0.2) (type default)) (fill solid) (layer "F.SilkS"))
  (fp_rect (start -1.15 -1.2) (end 2.5 1.2) (stroke (width 0.05) (type default)) (fill none) (layer "F.CrtYd"))
  (fp_circle (center 0 0) (end 0.9 0) (stroke (width 0.12) (type default)) (fill none) (layer "B.SilkS"))
  (pad "1" smd rect (at 1.4775 0.475) (size 0.545 0.65) (layers "F.Cu" "F.Paste" "F.Mask"))
  (pad "2" smd rect (at 1.4775 -0.475) (size 0.545 0.65) (layers "F.Cu" "F.Paste" "F.Mask"))
  (pad "3" smd custom (at 0.6 0) (size 0.25 0.25) (layers "F.Cu" "F.Paste" "F.Mask")
    (options (clearance outline) (anchor circle))
    (primitives (gr_circle (center -0.6 0) (end 0 0) (width 0.25) (fill none))))
  (pad "" np_thru_hole circle (at 0 0) (size 0.5 0.5) (drill 0.5) (layers "*.Cu" "*.Mask"))
  (model "${KIPRJMOD}/mic_board.3dshapes/MIC_GTA2718B_2.75x1.85x1.0mm.step"
    (offset (xyz 0 0 0)) (scale (xyz 1 1 1)) (rotate (xyz 0 0 0)))
)

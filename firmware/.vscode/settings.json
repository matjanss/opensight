{
    // Portable across machines (macOS, Linux): the globs match the PlatformIO toolchain
    // wherever ~/.platformio lives. The compile database comes from .clangd; create it once
    // per machine with `pio run -t compiledb`.
    "clangd.arguments": [
        "--query-driver=**/.platformio/packages/toolchain-*/bin/*",
        "--background-index=false"
    ]
}

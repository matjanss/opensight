# PlatformIO
firmware/.pio/
# Rust
app/target/
# clangd
.cache/
firmware/compile_commands.json
# Editors (PlatformIO regenerates these with machine-specific paths)
**/.vscode/.browse.c_cpp.db*
**/.vscode/c_cpp_properties.json
**/.vscode/launch.json
**/.vscode/ipch
# VS Code workspace file: the pioarduino extension writes machine-specific paths into it
opensights.code-workspace
# KiCad (local history, backups, caches, per-user view state)
hardware/**/.history/
hardware/**/*-backups/
hardware/**/fp-info-cache
hardware/**/*.lck
hardware/**/~*.lck
hardware/**/_autosave-*
hardware/**/*.kicad_prl
# The replay tool (firmware/tools/replay.cpp), built locally
firmware/tools/replay
# Serial logs (pio device monitor --filter log2file)
logs/
# Python
__pycache__/

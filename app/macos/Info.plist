<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The macOS app bundle. macOS only grants Bluetooth to a bundle that says why it needs it.
     VERSION is filled in by the release workflow. -->
<plist version="1.0">
<dict>
    <key>CFBundleName</key>
    <string>OpenSights</string>
    <key>CFBundleDisplayName</key>
    <string>OpenSights</string>
    <key>CFBundleIdentifier</key>
    <string>io.github.matjanss.opensight</string>
    <key>CFBundleExecutable</key>
    <string>opensights-app</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>VERSION</string>
    <key>CFBundleVersion</key>
    <string>VERSION</string>
    <key>LSMinimumSystemVersion</key>
    <string>11.0</string>
    <key>NSHighResolutionCapable</key>
    <true/>
    <key>NSBluetoothAlwaysUsageDescription</key>
    <string>OpenSights connects to your targets over Bluetooth to show your shots.</string>
</dict>
</plist>
